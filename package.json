{
  "name": "@xyin-anl/olcli",
  "version": "0.8.0-experimental.0",
  "description": "Experimental Overleaf CLI fork with native tracked-review and agent workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "olcli": "dist/cli.js",
    "olcli-mcp": "dist/mcp.js",
    "git-remote-overleaf": "dist/remote-helper.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "test:e2e": "bash test/e2e.sh",
    "test:e2e:review": "npm run build && bash test/e2e-review.sh",
    "test:e2e:resolve": "npm run build && bash test/e2e-resolve.sh",
    "test:e2e:review-workflow": "npm run build && bash test/e2e-review-workflow.sh",
    "test:e2e:comment-anchors": "npm run build && bash test/e2e-comment-anchors.sh",
    "test:e2e:history": "npm run build && bash test/e2e-history.sh",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify",
    "mcp": "node dist/mcp.js",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "overleaf",
    "overleaf-cli",
    "latex",
    "latex-cli",
    "cli",
    "command-line",
    "sync",
    "tex",
    "pdf",
    "academic",
    "writing",
    "latex-editor",
    "overleaf-sync",
    "research",
    "compile",
    "arxiv",
    "terminal",
    "typescript",
    "latex-tools"
  ],
  "author": "Alexander Loth <alex@alexloth.com> (https://alexloth.com)",
  "contributors": [
    "Xin Yin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyin-anl/olcli.git"
  },
  "bugs": {
    "url": "https://github.com/xyin-anl/olcli/issues"
  },
  "homepage": "https://github.com/xyin-anl/olcli#readme",
  "publishConfig": {
    "access": "public",
    "tag": "experimental"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.16",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "ignore": "^7.0.5",
    "ora": "^8.0.1",
    "tough-cookie": "^4.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "@types/tough-cookie": "^4.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "MIGRATION.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/*.md"
  ]
}
